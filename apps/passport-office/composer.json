{
    "name": "butterfly/passport-office",
    "type": "project",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "mailweb/laravel-mailweb": "dev-main"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../systems/mailweb/packages/laravel-mailweb",
            "options": {
                "symlink": false
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php artisan package:discover --ansi"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}